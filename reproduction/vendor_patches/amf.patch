@@ -0,0 +1,66 @@
+"""Run paired ten-seed MetaWorld protocols with persistent configs and logs."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+import yaml
+import argparse
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--worker', type=int, default=0)
+parser.add_argument('--workers', type=int, default=1)
+args = parser.parse_args()
+
+root = Path(__file__).resolve().parent
+output = root / 'outputs' / 'metaworld_paper'
+output.mkdir(parents=True, exist_ok=True)
+base = yaml.safe_load((root / 'reproduction_metaworld_smoke.yaml').read_text())
+base.update(pre_epochs=200, rollout_every=200, sample_every=5, val_every=1,
+            finetune_iters=20, finetune_epochs=1, finetune_gradient_steps=3000,
+            eval_episodes_override=50, num_parallel_envs=5, env_sync=True,
+            paper_adaptive_mixture=True, protocol='paper Appendix M; state MetaWorld',
+            wandb_group='amf-metaworld-paper', checkpoint_every=1)
+jobs = []
+for seed in range(10):
+    for regime in ['mismatch', 'matched']:
+        for method in ['posterior_grad', 'uniform_prior', 'uniform']:
+            global_index = seed * 6 + (0 if regime == 'mismatch' else 3) + ['posterior_grad', 'uniform_prior', 'uniform'].index(method)
+            if global_index % args.workers != args.worker:
+                continue
+            name = f'amf-metaworld-{regime}-{method}-seed{seed}'
+            directory = output / name
+            directory.mkdir(exist_ok=True)
+            cfg = dict(base, seed=seed, exp_name=name, working_dir=str(directory),
+                       finetune_strategy='posterior_grad' if method=='posterior_grad' else 'uniform',
+                       finetune_prior=method!='uniform',
+                       pre_demos=dict(cup_left=8, cup_right=8, faucet_open=0, faucet_close=0)
+                       if regime=='mismatch' else dict(cup_left=4, cup_right=4,faucet_open=4,faucet_close=4))
+            config_path = directory / 'input.yaml'
+            config_path.write_text(yaml.safe_dump(cfg))
+            jobs.append(dict(name=name, config=str(config_path), directory=str(directory), cfg=cfg))
+(output / f'queue_worker{args.worker}.json').write_text(json.dumps([{k:v for k,v in j.items() if k!='cfg'} for j in jobs],indent=2))
+for index, job in enumerate(jobs):
+    directory = Path(job['directory'])
+    if (directory/'complete.json').exists():
+        continue
+    status = dict(current=job['name'], index=index, total=len(jobs), config=job['cfg'],
+                  next=jobs[index+1]['name'] if index+1<len(jobs) else None, updated=time.time())
+    (output/f'status_worker{args.worker}.json').write_text(json.dumps(status,indent=2))
+    print('STARTING '+job['name'],flush=True)
+    with (directory/'console.log').open('a') as log:
+        result = subprocess.run([sys.executable, '-u', 'main.py',job['config']],cwd=root,stdout=log,stderr=subprocess.STDOUT)
+    status.update(exit_code=result.returncode,updated=time.time())
+    (output/f'status_worker{args.worker}.json').write_text(json.dumps(status,indent=2))
+    if result.returncode:
+        with (root.parent.parent/'logs/reproduction_errors.txt').open('a') as errors:
+            errors.write(f"\n{time.ctime()} {job['name']} exit={result.returncode}\n")
+            errors.write((directory/'console.log').read_text()[-12000:])
+        raise RuntimeError(f"Job failed: {job['name']}; inspect console.log")
+    metrics=[json.loads(line) for line in (directory/'metrics.jsonl').read_text().splitlines()]
+    if not metrics or metrics[-1]['epoch']!=219 or 'mean_score' not in metrics[-1]:
+        raise RuntimeError('Missing final evaluation: '+job['name'])
+    (directory/'complete.json').write_text(json.dumps(metrics[-1],indent=2))
+    print('COMPLETED '+job['name']+' '+str(metrics[-1]['mean_score']),flush=True)
+(output/f'status_worker{args.worker}.json').write_text(json.dumps(dict(complete=True,total=len(jobs)),indent=2))

