+def successful_demo(demo):
+    """Keep finite trajectories with an observed success, not merely reward >= 0."""
+    required = ('obs', 'actions', 'next_obs', 'rewards', 'dones')
+    if not all(key in demo for key in required):
+        return False
+    length = len(demo['actions'])
+    if length == 0 or any(len(demo[key]) != length for key in required):
+        return False
+    return (all(np.isfinite(demo[key]).all() for key in required)
+            and bool(np.any(demo['rewards'] > 0)))
 
 
