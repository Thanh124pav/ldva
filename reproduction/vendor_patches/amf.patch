new file mode 100644
--- /dev/null
+++ b/reproduce_gp.py
@@ -0,0 +1,150 @@
+"""Run released GP experiments with durable, resumable CPU checkpoints."""
+
+import argparse
+import hashlib
+import json
+import os
+import pickle
+from pathlib import Path
+
+import numpy as np
+
+
+def atomic_write(path, payload):
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    with temporary.open('wb') as stream:
+        stream.write(payload)
+        stream.flush()
+        os.fsync(stream.fileno())
+    os.replace(temporary, path)
+
+
+def save_results(output, state):
+    # Save recovery checkpoint before generating reports or plots.
+    atomic_write(output / 'checkpoint.pkl', pickle.dumps(state))
+    summary = {}
+    lines = ['# AMF-GP results', '',
+             'Partial results; smoke tests are not paper reproductions.', '',
+             '| Prior support | Method | Completed seeds | Final return mean | Std |',
+             '|---|---|---:|---:|---:|']
+    for support, methods in sorted(state['metrics'].items()):
+        summary[str(support)] = {}
+        for method, runs in methods.items():
+            if not runs:
+                continue
+            values = [run['performance'].mean(axis=0)[-1] for run in runs.values()]
+            summary[str(support)][method] = dict(
+                completed_seeds=len(values), mean_final_return=float(np.mean(values)),
+                std_final_return=float(np.std(values)))
+            lines.append(f'| {support} | {method} | {len(values)} | '
+                         f'{np.mean(values):.8f} | {np.std(values):.8f} |')
+    atomic_write(output / 'summary.json', json.dumps(summary, indent=2).encode())
+    atomic_write(output / 'results.md', ('\n'.join(lines) + '\n').encode())
+    return summary
+
+
+def run_experiments(ns, output, signature, supports, seeds, budget, on_saved=None):
+    output.mkdir(parents=True, exist_ok=True)
+    checkpoint = output / 'checkpoint.pkl'
+    if checkpoint.exists():
+        # Only load checkpoints produced locally by this script.
+        state = pickle.loads(checkpoint.read_bytes())
+        if state['signature'] != signature:
+            raise ValueError('Checkpoint/config mismatch; choose another output directory')
+        np.random.set_state(state['rng'])
+    else:
+        np.random.seed(0)
+        state = dict(signature=signature, metrics={}, holdout_tasks=None)
+    for support in supports:
+        methods = state['metrics'].setdefault(support, {'active': {}, 'uniform': {}})
+        prior = {k: 0 for k in range(ns['N_TASKS'])}
+        for i in range(ns['N_TASKS']):
+            prior[i % support] += 1
+        for seed in range(seeds):
+            if seed in methods['uniform']:
+                continue
+            if seed not in methods['active']:
+                state['holdout_tasks'] = np.random.choice(12, 1)
+                holdout = [ns['get_pretraining_dataset']({k: 1})
+                           for k in state['holdout_tasks']]
+                methods['active'][seed] = ns['run_experiment'](
+                    prior, method='amf', holdout_trajs=holdout,
+                    include_holdout=True, finetuning_budget=budget)
+                state['rng'] = np.random.get_state()
+                save_results(output, state)
+                print(f'SAVED support={support} seed={seed} method=active', flush=True)
+                if on_saved:
+                    on_saved(support, seed, 'active', methods['active'][seed])
+            holdout = [ns['get_pretraining_dataset']({k: 1})
+                       for k in state['holdout_tasks']]
+            methods['uniform'][seed] = ns['run_experiment'](
+                prior, method='uniform', holdout_trajs=holdout,
+                include_holdout=True, finetuning_budget=budget)
+            state['rng'] = np.random.get_state()
+            save_results(output, state)
+            print(f'SAVED support={support} seed={seed} method=uniform', flush=True)
+            if on_saved:
+                on_saved(support, seed, 'uniform', methods['uniform'][seed])
+    return state, save_results(output, state)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--output', type=Path, default=Path('outputs/gp'))
+    parser.add_argument('--smoke-test', action='store_true')
+    parser.add_argument('--no-plots', action='store_true')
+    parser.add_argument('--wandb-mode', choices=['online', 'offline', 'disabled'], default='offline')
+    parser.add_argument('--project', default='paper-reproduction')
+    parser.add_argument('--shooting-candidates', type=int, default=20)
+    args = parser.parse_args()
+    source = Path(__file__).with_name('AMF-GP.ipynb').read_bytes()
+    notebook = json.loads(source)
+    ns = {'__name__': '__main__'}
+    for index, cell in enumerate(notebook['cells'][:4]):
+        if cell['cell_type'] == 'code':
+            exec(compile(''.join(cell['source']), f'AMF-GP.ipynb:{index}', 'exec'), ns)
+    supports = [1] if args.smoke_test else list(range(1, 13))
+    seeds, budget = (1, 1) if args.smoke_test else (ns['N_SEEDS'], 40)
+    signature = (hashlib.sha256(source).hexdigest(), supports, seeds, budget)
+    if args.shooting_candidates != 20:
+        # Keep existing released-notebook checkpoint signatures compatible.
+        signature += (args.shooting_candidates,)
+        ns['select_task'].__defaults__ = (args.shooting_candidates,)
+    import wandb
+    args.output.mkdir(parents=True, exist_ok=True)
+    run = wandb.init(project=args.project, mode=args.wandb_mode,
+                     name='amf-gp-smoke' if args.smoke_test else f'amf-gp-shooting{args.shooting_candidates}',
+                     group='amf-gp', dir=str(args.output.resolve()),
+                     config=dict(paper='2410.05026v3', notebook_sha256=signature[0],
+                                 seeds=seeds, budget=budget, prior_supports=supports,
+                                 evaluation_episodes=20, random_shooting_candidates=args.shooting_candidates,
+                                 protocol='paper appendix shooting budget' if args.shooting_candidates==100 else 'released notebook shooting budget',
+                                 smoke_test=args.smoke_test))
+    def log_saved(support, seed, method, result):
+        for round_index, value in enumerate(result['performance'].mean(axis=0)):
+            run.log({'prior_support': support, 'seed': seed, 'round': round_index,
+                     f'{method}/return': float(value),
+                     f'{method}/uncertainty': float(result['uncertainties'].mean(axis=0)[round_index])})
+    state, summary = run_experiments(ns, args.output, signature, supports, seeds, budget, log_saved)
+    for support, methods in summary.items():
+        for method, values in methods.items():
+            for metric, value in values.items():
+                run.summary[f'prior_{support}/{method}/{metric}'] = value
+    artifact = wandb.Artifact('amf-gp-results', type='evaluation')
+    for filename in ['checkpoint.pkl', 'summary.json', 'results.md']:
+        artifact.add_file(str(args.output / filename))
+    run.log_artifact(artifact)
+    run.finish()
+    print('AMF_GP_SUMMARY=' + json.dumps(summary, sort_keys=True), flush=True)
+    if not args.no_plots and not args.smoke_test:
+        import matplotlib.pyplot as plt
+        plt.rcParams.update({'text.usetex': False, 'font.family': 'DejaVu Sans'})
+        try:
+            ns['plot_all'](state['metrics'], str(args.output / 'result'))
+        except Exception as exc:
+            print(f'PLOT_FAILED (metrics already saved): {exc}', flush=True)
+            raise
+
+
+if __name__ == '__main__':
+    main()

