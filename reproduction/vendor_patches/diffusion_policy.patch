@@ -11,6 +11,16 @@ from robomimic.config import config_factory
 
 
 class RobomimicAbsoluteActionConverter:
+    @staticmethod
+    def _arm_controller(robot):
+        """Return the arm controller for robosuite 1.4 and 1.5 APIs."""
+        if hasattr(robot, 'controller'):
+            return robot.controller
+        for arm_name in getattr(robot, 'arms', []):
+            if arm_name in robot.part_controllers:
+                return robot.part_controllers[arm_name]
+        raise RuntimeError('Could not locate a robosuite arm controller')
+
     def __init__(self, dataset_path, algo_name='bc'):
         # default BC config
         config = config_factory(algo_name=algo_name)
