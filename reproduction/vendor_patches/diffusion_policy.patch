+        controller_config = abs_env_meta['env_kwargs']['controller_configs']
+        # robosuite <=1.4 uses control_delta at the controller root. In 1.5,
+        # BASIC is a composite controller and each arm uses input_type.
+        if 'body_parts' in controller_config:
+            for part_config in controller_config['body_parts'].values():
+                if part_config.get('type', '').startswith('OSC_'):
+                    part_config['input_type'] = 'absolute'
+        else:
