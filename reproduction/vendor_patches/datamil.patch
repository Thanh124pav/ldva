diff --git a/datamil/metagradients/resume_state.py b/datamil/metagradients/resume_state.py
new file mode 100644
--- /dev/null
+++ b/datamil/metagradients/resume_state.py
@@ -0,0 +1,29 @@
+"""Atomic array-only replay state, reconstructed against a fresh optimizer tree."""
+import os
+from pathlib import Path
+import pickle
+import jax
+import numpy as np
+
+def save_state(path, state):
+    path=Path(path)
+    leaves=jax.tree_util.tree_leaves(state)
+    arrays=[np.asarray(jax.device_get(x)) for x in leaves]
+    value=dict(step=int(state.opt_state.count),
+               shapes=[x.shape for x in arrays],dtypes=[str(x.dtype) for x in arrays],leaves=arrays)
+    temporary=path.with_suffix('.tmp')
+    with temporary.open('wb') as f:
+        pickle.dump(value,f,protocol=5); f.flush(); os.fsync(f.fileno())
+    temporary.replace(path)
+
+def restore_state(path, template):
+    # Only load files generated by this trusted local run.
+    with Path(path).open('rb') as f: value=pickle.load(f)
+    leaves,definition=jax.tree_util.tree_flatten(template)
+    assert value['shapes']==[np.shape(x) for x in leaves], 'Replay state shape mismatch'
+    expected_dtypes=[str(x.dtype) if hasattr(x,'dtype') else
+                     str(np.asarray(jax.device_get(jax.device_put(x))).dtype) for x in leaves]
+    assert value['dtypes']==expected_dtypes, 'Replay state dtype mismatch'
+    state=jax.tree_util.tree_unflatten(definition,value['leaves'])
+    assert int(state.opt_state.count)==value['step']
+    return state

