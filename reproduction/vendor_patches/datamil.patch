+"""Released configuration with explicit cached stats and bounded CPU loaders."""
+from pathlib import Path
+from ml_collections import ConfigDict
+from scripts.configs.cotrain_libero_config import get_config as released_config
+
+def get_config(config_string=''):
+    cfg = released_config(config_string)
+    for dataset in cfg.dataset_kwargs_list:
+        files = list((Path(dataset['data_dir'])/dataset['name']/'0.1.0').glob('dataset_statistics_*.json'))
+        if len(files) != 1:
+            raise ValueError(f"Expected exactly one cached statistics file: {dataset['name']}: {files}")
+        dataset['dataset_statistics'] = str(files[0])
+    cfg.data_parallel_calls = 2
+    cfg.data_parallel_reads = 2
+    cfg.wandb.project = 'paper-reproduction'
+    cfg.wandb.entity = 'hust_edu_vn'
+    cfg.wandb.group = 'datamil-fresh-training'
+    # Keep CLI-overridable placeholders typed after resolving references.
+    cfg.pretrained_path = ''
+    cfg.save_dir = ''
+    # Resolve shared FieldReferences: changing the pilot's stopping step must
+    # not silently change the paper's 10k-step learning-rate schedule.
+    return ConfigDict(cfg.to_dict())
